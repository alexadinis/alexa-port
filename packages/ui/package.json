{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/index.css",
    "./card": "./src/card.tsx"
  },
  "license": "MIT",
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "check-types": "tsc --noEmit",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "lint": "eslint src --max-warnings 0",
    "icons": "svgr --template ./icon-template.js --index-template ./icon-index-template.js --ref --ext tsx --svgo-config ./svgo.config.json --no-prettier --replace-attr-values \"#E5E1E1=currentColor\" --no-dimensions ./icons/source --out-dir ./icons"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@svgr/cli": "5.5.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.7",
    "eslint": "^9.20.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.6",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "next": "^15.1.6",
    "radash": "^12.1.0",
    "react-dom": "^19.0.0"
  }
}
