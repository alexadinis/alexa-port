{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": ["../../packages/ui/src/components/*"],
      "@/layouts/*": ["../../packages/ui/src/components/layouts/*"],
      "@/primitives/*": ["../../packages/ui/src/components/primitives/*"],
      "@/constants/*": ["../../packages/ui/src/constants/*"],
      "@/utils": ["../../packages/ui/src/utils"],
      "@/utils/*": ["../../packages/ui/src/utils/*"],
      "@/styles/*": ["../../packages/ui/src/styles/*"],
      "@/icons": ["../../packages/ui/icons"],
      "@/icons/*": ["../../packages/ui/icons/*"],
      "@/hooks/*": ["../../packages/ui/src/hooks/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
